---
import Layout from "#layouts/layout.astro";

import { container, hstack } from "#styled-system/patterns";
import { css } from "#styled-system/css";
import { Button } from "#components/ui/button";
import { Badge } from "#components/ui/badge";
import { Heading } from "#components/ui/heading";
import * as Card from "#components/ui/card";
import * as Navbar from "#components/ui/navbar";
import { getCollection } from "astro:content";
import { linkOverlay } from "#styled-system/patterns/link-overlay";

const posts = await getCollection("blog");
---

<Layout>
    <Navbar.Root boxed>
        <Navbar.Start>
            <p>Logo</p>
        </Navbar.Start>
        <Navbar.Content>
            <p>Main content</p>
        </Navbar.Content>
        <Navbar.End>
            <p>End nav</p>
        </Navbar.End>
    </Navbar.Root>
    <div class={container({ spaceY: "4" })}>
        <Heading as="h1" level="h3">
            Astro
        </Heading>
        <div class={hstack({ gap: "4" })}>
            <Button size="xs">First button</Button>
            <Button variant="ghost" size="lg">
                First button
            </Button>
            <Button variant="subtle">First button</Button>
            <Button
                size="sm"
                class={css({ colorPalette: "red", rounded: "xl" })}
            >
                First button
            </Button>
        </div>
        <div class={hstack({ gap: "4" })}>
            {["badge", "tag", "tech", "ui", "tip"].map((t) => (
                <Badge>{t}</Badge>
            ))}
        </div>
        {posts.map((post) => (
            <Card.Root class={css({ pos: "relative" })}>
                <Card.Header>
                    <Card.Title>{post.data.title}</Card.Title>
                </Card.Header>
                <Card.Footer>
                    <Button
                        as="a"
                        href={`/blog/${post.id}`}
                        class={linkOverlay()}
                    >
                        Lire
                    </Button>
                </Card.Footer>
            </Card.Root>
        ))}
    </div>
</Layout>
