---
import type { HTMLAttributes } from "astro/types";
import { button, type ButtonVariantProps } from "#styled-system/recipes";
import { cx } from "#styled-system/css";
import type { StyledSystemObject } from "#styled-system/types";

type Props = HTMLAttributes<"button"> &
    ButtonVariantProps & {
        css?: StyledSystemObject;
    };

const { variant, size, css: cssProp, class: className } = Astro.props;
const classes = cx(button({ variant, size }), cssProp);
---

<button class:list={[classes, className]}>
    <slot />
</button>
