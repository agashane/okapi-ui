---
import { link, type LinkVariantProps } from "#styled-system/recipes/link";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a">, LinkVariantProps {}

const { class: className, variant, ...props } = Astro.props;
---

<a class:list={[link({ variant }), className]}>
    <slot />
</a>
