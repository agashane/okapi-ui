---
import {
    breadcrumb,
    type BreadcrumbVariantProps,
} from "#styled-system/recipes/breadcrumb";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"nav">, BreadcrumbVariantProps {}

const { class: className, ...props } = Astro.props;
---

<nav
    aria-label="breadcrumb"
    data-slot="breadcrumb"
    {...props}
    class:list={[breadcrumb().root, className]}
>
    <slot />
</nav>
