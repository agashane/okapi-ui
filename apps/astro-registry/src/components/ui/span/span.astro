---
import type { HTMLAttributes } from "astro/types";
import { text, type TextVariantProps } from "#styled-system/recipes/text";

interface Props extends HTMLAttributes<"span">, TextVariantProps {}

const { size, weight, muted, lead, class: className, ...props } = Astro.props;
---

<span class:list={[text({ size, weight, muted, lead }), className]} {...props}>
    <slot />
</span>
