{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "#layouts/*": ["./src/layouts/*"],
      "#okapi/*": ["./src/okapi/*"],
      "#styled-system/*": ["./styled-system/*"],
    },
    "plugins": [
      {
        "name": "@astrojs/ts-plugin",
      },
    ],
  },
}
